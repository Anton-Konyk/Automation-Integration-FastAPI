# Timezone (IANA), e.g. Europe/Bratislava
TZ=Europe/Bratislava

# Celery ↔ Redis (inside Docker use host 'redis', not 'localhost')
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# External API endpoint for users (default demo API)
USERS_API_URL=https://jsonplaceholder.typicode.com/users

# Output directory for CSVs (must be /data in Docker)
CSV_DIR=/data

# Interval (in minutes) for Celery Beat to run the fetch task.
# Examples: 60 = hourly, 1440 = daily.
FETCH_EVERY_MINUTES=60
